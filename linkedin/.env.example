# 1. Create an app: https://www.linkedin.com/developers/apps
# 2. Auth tab → copy Client ID + Client Secret here
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Default works on macOS/Linux; change if port 8765 is taken.
# Must match the redirect URL configured in the LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# 3. After running oauth_helper.py, paste the access token here.
# (oauth_helper prints it after the browser callback succeeds.)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
